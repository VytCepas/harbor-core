#!/usr/bin/env sh
# GOVERNANCE (harbor#7) — run the suites this push actually selects, before the
# push, rather than discovering them red on a serialised CI runner afterwards.
#
# Install:  ln -sf ../../hooks/pre-push .git/hooks/pre-push
# Bypass:   git push --no-verify   (deliberate, visible, and rare)
#
# Why push, not commit: pre-commit already pays for the guard smoke suite when a floor surface is staged; running the whole selected set per commit gets `--no-verify`'d routinely and protects nothing (2.11). Push is once per branch and the last point before CI spends the runner.
# The selector (bin/test-suite-select.sh, contracts/suite-paths.txt) does the conditionality; reimplementing it here would be a silent second copy of CI's policy.
# The default is narrow (harbor#7): bin/eval-hook-replay.sh --commits showed the selector returns a median 24 of 25 suites, which would be `--no-verify`'d within a week and duplicates CI.
# So: the conventions linter plus the guard smoke suite when a floor surface is in the pushed range; HARBOR_GATE_PREPUSH_FULL=1 runs the full selected set (the runner is serialised, so a red push blocks every queued branch).
# Removed notes: docs/explanation/code-cases/hooks-pre-push.md
set -eu
ROOT="$(git rev-parse --show-toplevel)"
BASE_BRANCH="${HARBOR_CI_BASE_BRANCH:-main}"

[ -f "$ROOT/bin/test-suite-select.sh" ] || exit 0
[ -f "$ROOT/contracts/suites.txt" ] || exit 0

# harbor#824: everything below that runs a suite or the linter goes through hook_scrub_run (hooks/lib.sh), which drops the GIT_* vars git exports into this hook; the git calls above keep the real GIT_DIR on purpose.
# lib.sh is resolved BESIDE THIS FILE (following the .git/hooks/pre-push symlink), never under $ROOT, which is the repo the hook fires for; with no lib.sh beside it the run degrades to unscrubbed.
_hk_self="$0"
while [ -L "$_hk_self" ]; do
  _hk_link="$(readlink "$_hk_self")"
  case "$_hk_link" in /*) _hk_self="$_hk_link" ;; *) _hk_self="$(dirname "$_hk_self")/$_hk_link" ;; esac
done
_hk_here="$(CDPATH= cd -- "$(dirname -- "$_hk_self")" && pwd)"
if [ -f "$_hk_here/lib.sh" ]; then . "$_hk_here/lib.sh"
else hook_scrub_run() { env "$@"; }  # same calling convention as the real one (VAR=val leading args), just no -u
fi

# A pass already paid for before the connection (harbor#1411): git holds the App token from connect to pack send, so a long hook ends in HTTP 401.
# `sh bin/gate-push.sh` runs this hook under `git push --dry-run`, records the pass, then pushes; `gate-push.sh check` answers 0 only for that exact sha, push and check set.
# gate-push: file lib.sh ../bin/gate-push.sh
# gate-push: env HARBOR_GATE_PREPUSH_FULL HARBOR_CI_BASE_BRANCH HARBOR_TEST_CHANGED
if [ -f "$_hk_here/../bin/gate-push.sh" ]; then
  _gp_in="$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
  cat > "$_gp_in"
  if sh "$_hk_here/../bin/gate-push.sh" check "$@" < "$_gp_in"; then rm -f "$_gp_in"; exit 0; fi
  exec < "$_gp_in"; rm -f "$_gp_in"
fi

# One CPU slot per check through bin/ci-governor.sh; output discarded, the governor's waiting line stays on stderr. No governor or state dir: run directly.
_quiet() { # <cmd…> — env VAR=val as a prefix when the check needs one
  if [ -f "$ROOT/bin/ci-governor.sh" ]; then hook_scrub_run sh "$ROOT/bin/ci-governor.sh" run --out /dev/null -- "$@"
  else hook_scrub_run "$@" >/dev/null 2>&1; fi
}

# The range comes from stdin (<local ref> <local sha> <remote ref> <remote sha>): the remote sha is what the remote has NOW, fresher than origin/<base>. An all-zero remote sha (new branch) falls through to the selector's default.
# A push of only deletions has no subject (harbor#575): the decision is over the WHOLE push, since `git push origin :old main` deletes one ref and publishes another.
_range=''; _refs=0; _deleted=0
while read -r _lref _lsha _rref _rsha; do
  [ -n "${_lsha:-}" ] || continue
  _refs=$(( _refs + 1 ))
  case "$_lsha" in *[!0]*) ;; *) _deleted=$(( _deleted + 1 )); continue ;; esac
  case "${_rsha:-}" in
    ''|*[!0-9abcdef]*) continue ;;
    *[!0]*) _range="$_rsha..$_lsha" ;;
  esac
done
[ -n "$_range" ] || _range=""

# Say it stood down: a silent hook on a deletion push reads like one that did not fire (harbor#466).
if [ "$_refs" -gt 0 ] && [ "$_deleted" -eq "$_refs" ]; then
  echo ""
  printf 'pre-push: 0 check(s) run — all %s ref(s) in this push are deletions, which publish nothing to test.\n' "$_refs"
  exit 0
fi

if [ -n "$_range" ]; then
  HARBOR_TEST_CHANGED="$(git -C "$ROOT" diff --name-only --no-renames "$_range" 2>/dev/null || true)"
  export HARBOR_TEST_CHANGED
  [ -n "${HARBOR_TEST_CHANGED:-}" ] || unset HARBOR_TEST_CHANGED
fi
export HARBOR_CI_BASE="origin/$BASE_BRANCH"

echo ""
_ran=0; _stood=0; _rc=0

# A stale generated file fails here in seconds (harbor#1287), BEFORE the linter and suites: bin/doc-fresh-verify.sh runs every generator --check that answers fast (contracts/fresh-checks.tsv).
# control: git.pre-push-fresh-verify
if [ -f "$ROOT/bin/doc-fresh-verify.sh" ]; then
  _ran=$(( _ran + 1 ))
  if _fc="$(hook_scrub_run sh "$ROOT/bin/doc-fresh-verify.sh" 2>&1)"; then
    printf '          run   doc-fresh-verify.sh  ok\n'
  else
    printf '          run   doc-fresh-verify.sh  FAILED\n'
    printf '%s\n' "$_fc" | sed 's/^/          /'
    echo "" >&2
    echo "pre-push: a generated file is STALE. Run the fix above, commit it, push again — or push deliberately with --no-verify." >&2
    exit 1
  fi
fi

# control: git.pre-push-suites
if [ "${HARBOR_GATE_PREPUSH_FULL:-0}" = 1 ]; then
  echo "pre-push: FULL mode — every suite bin/test-suite-select.sh picks for this push."
  [ -n "${HARBOR_TEST_CHANGED:-}" ] && printf '%s\n' "${HARBOR_TEST_CHANGED:-}" | sed 's/^/          /'
  while IFS= read -r _s; do
    case "$_s" in ''|\#*) continue ;; esac
    # A path entry is relative to the repo root; a bare name lives in bin/ (harbor#695).
    case "$_s" in */*) _sp="$ROOT/$_s" ;; *) _sp="$ROOT/bin/$_s" ;; esac
    [ -f "$_sp" ] || continue
    if hook_scrub_run sh "$ROOT/bin/test-suite-select.sh" "$_s" >/dev/null 2>&1; then
      _ran=$(( _ran + 1 ))
      printf '          run   %s' "$_s"
      if _quiet sh "$_sp"; then printf '  ok\n'; else printf '  FAILED\n'; _rc=1; fi
    else
      _stood=$(( _stood + 1 ))
    fi
  done < "$ROOT/contracts/suites.txt"
else
  echo "pre-push: conventions + the guard smoke suite if a floor surface moved."
  echo "          (HARBOR_GATE_PREPUSH_FULL=1 for every selected suite — median 24 of 25 here.)"
  # The only local run of the linter (it moved out of pre-commit: it is repo-wide, so not filterable by staged path). Guarded for existence: a repo without it must not have pushes rejected.
  # control: git.pre-push-lint
  if [ -f "$ROOT/bin/lint-conventions.sh" ]; then
    _ran=$(( _ran + 1 ))
    printf '          run   lint-conventions.sh'
    if _quiet sh "$ROOT/bin/lint-conventions.sh"; then printf '  ok\n'; else printf '  FAILED\n'; _rc=1; fi
  fi

  # Same trigger as pre-commit, over the whole pushed RANGE. `case` globs, not grep (this box's grep is a ugrep wrapper).
  _floor=0; _floor_ran=0
  for _p in ${HARBOR_TEST_CHANGED:-}; do
    case "$_p" in
      bin/admission-*.sh|bin/library-admission.sh|bin/guard-*.sh|bin/floor-*.sh|bin/floor-*.awk|bin/admission-*.awk|bin/deploy-harden.sh|hooks/*) _floor=1 ;;
    esac
  done
  # control: git.pre-push-admission-smoke
  if [ "$_floor" = 1 ] && [ -f "$ROOT/tests/admission/baseline/baseline.test.sh" ]; then
    _ran=$(( _ran + 1 ))
    _floor_ran=1
    printf '          run   floor-test.sh smoke'
    if _quiet env T_SMOKE=1 sh "$ROOT/tests/admission/baseline/baseline.test.sh"; then printf '  ok\n'; else printf '  FAILED\n'; _rc=1; fi
  fi
  # Count exactly the manifest suites this run did not execute (lint-conventions.sh is not in suites.txt; the floor smoke is).
  # `grep -c` exits 1 on zero matches and `set -eu` would abort the push after every check passed: `|| true` is required.
  _total="$(grep -cvE '^[[:space:]]*(#|$)' "$ROOT/contracts/suites.txt" 2>/dev/null || true)"
  _total="${_total:-0}"
  _stood="$(( _total - _floor_ran ))"
fi

# The stood-down count prints on every run, so a pass is never mistaken for full coverage.
printf 'pre-push: %s check(s) run, %s suite(s) NOT run here — CI runs the selection on the PR.\n' "$_ran" "$_stood"

if [ "$_rc" -ne 0 ]; then
  echo ""
  echo "pre-push: a selected suite is RED. Fix it, or push deliberately with --no-verify." >&2
  echo "          Re-run one by name for its output:  sh bin/<suite>.sh" >&2
  exit 1
fi
exit 0
