#!/usr/bin/env sh
# GOVERNANCE (harbor#1116) — a new linked worktree is born with the memory store routed.
# Removed notes: docs/explanation/code-cases/hooks-post-checkout.md
# Install:  ln -sf ../../hooks/post-checkout .git/hooks/post-checkout   (core.hooksPath needs nothing)
# Box-wide, every repo (harbor#966): git config --global hook.harbor-memory-route.event post-checkout
#                                     git config --global hook.harbor-memory-route.command <harbor>/hooks/post-checkout
# git runs this on every checkout; only a worktree's first one (previous HEAD all zeros, git-dir differing from the common dir) acts. memory-route.sh --apply stays the one linker; exit 0 on every path.
# Box-wide (harbor#966): a config hook runs beside each repo's own hooks whatever its hooksPath; worktrees outside $HOME (suite fixtures) are never routed.
set -u
_prev="${1:-}"
case "$_prev" in *[!0]*|"") exit 0 ;; esac   # not all zeros: an ordinary checkout
_gd="$(CDPATH= cd -P -- "$(git rev-parse --git-dir 2>/dev/null)" 2>/dev/null && pwd -P)" || exit 0
_cd="$(CDPATH= cd -P -- "$(git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null && pwd -P)" || exit 0
[ "$_gd" != "$_cd" ] || exit 0               # a fresh clone is not a linked worktree

_phys() { CDPATH= cd -P -- "$1" 2>/dev/null && pwd -P || printf '%s' "$1"; }
_cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
_top="$(_phys "$(git rev-parse --show-toplevel 2>/dev/null)")"
case "$_top/" in "$(_phys "$HOME")/"*) ;; *) exit 0 ;; esac
[ ! -L "$_cfg/projects/$(printf '%s' "$_top" | sed 's|/|-|g')/memory" ] || exit 0

_hk_self="$0"
while [ -L "$_hk_self" ]; do
  _hk_link="$(readlink "$_hk_self")"
  case "$_hk_link" in /*) _hk_self="$_hk_link" ;; *) _hk_self="$(dirname "$_hk_self")/$_hk_link" ;; esac
done
_hk_root="$(CDPATH= cd -- "$(dirname -- "$_hk_self")/.." && pwd)"
[ -f "$_hk_root/bin/memory-route.sh" ] || exit 0

if [ "$(_phys "$_cfg")" = "$(_phys "$HOME/.claude")" ]; then set -- --live; else set -- --dir "$_cfg"; fi

if env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX \
     sh "$_hk_root/bin/memory-route.sh" "$@" --apply --quiet >/dev/null 2>&1; then :
else
  _why=""; [ -w "$_cfg/projects" ] || _why=" (the config dir's projects/ is not writable here: a sandboxed command cannot route, re-run with the sandbox off)"
  printf 'post-checkout: memory route incomplete%s, a session in this worktree may start with no memory: sh %s/bin/memory-route.sh %s --apply\n' "$_why" "$_hk_root" "$*" >&2
fi
exit 0
