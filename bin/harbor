#!/usr/bin/env sh
# harbor (CLI-1, harbor#42) — the L0 command surface. One door, not eleven.
#
# NOT A LAUNCHER. `claude` stays the command you type; Helm's logic is ambient
# (hooks, ~/.claude/CLAUDE.md, installed skills) and applies however a session
# starts. A wrapper terminal would protect only the sessions someone remembered to
# start through it, which is when a floor is least useful. This is a MANAGEMENT
# command — install, verify, repair, report. Closer to `brew` than to `tmux`.
#
# POSIX sh, and that is load-bearing: `harbor restore` exists for the case where
# the machine is broken, so the dispatcher must not need a runtime that might be
# part of what broke.
#
# THE VERB LIST IS EMBEDDED, NOT PARSED FROM THE CONTRACT. contracts/cli.md is the
# human source of truth and lint rule CLI1 asserts this table is identical to it —
# the mechanism against a drifting second copy is the equality check, not a
# generation step. Reading a markdown file out of a repo checkout to print --help
# would make recovery depend on that checkout, which is the same argument as the
# language choice above.
set -eu

CONTRACT_VERSION=1

# verb<TAB>script [fixed args]<TAB>json<TAB>summary — the single in-script source for dispatch
# AND for --help, so the two cannot disagree with each other. A script may carry fixed arguments
# before the caller's: the install verbs are deploy's components (harbor#800, the install standard
# §4: deploy is the only live entry, so a verb gets its preflight, snapshot and verify), and `verify`
# is the live box's check, whose target is named by --live and never implied. `deploy` is deploy.sh
# whole, every argument passed through (an operator-approved CLI1 amendment, 2026-09-30).
VERBS="
status	status-generate.sh	yes	the generated counts (docs/generated/status.md)
doctor	deploy-doctor.sh	yes	external dependencies, each row naming what breaks
verify	admission-verify.sh --live	no	is the floor ON here? fires known-blocked shapes at ~/.claude
check	deploy-live-verify.sh	no	the live tier: does the installed box work? every live check, read-only (--live [--probes])
lint	lint-conventions.sh	no	the conventions gate
fresh	doc-freshness.sh	no	document + working-context staleness (--open for markers)
cite	doc-cite-verify.sh	no	citation drift against docs/reference/citations.md (network)
observe	admission-observe-report.sh	no	the guard-decision ledger
dash	status-dashboard-generate.sh	no	render build/dashboard.html (--open to open it)
deploy	deploy.sh	no	install everything onto this box, from any directory: --live plans, --apply --live installs
install	deploy.sh --only floor	no	install the floor through deploy: --live plans, --apply --live installs
uninstall	deploy.sh --only floor --uninstall	no	remove the floor through deploy: --live plans, --apply --live removes
restore	deploy-restore.sh	no	put the config dir back from a deploy snapshot (dry-run unless --apply)
skills	deploy.sh --only skills	no	every tracked skill and command, through deploy: --live plans, --apply --live installs
inject	deploy.sh --only inject	no	the just-in-time injector, through deploy: --live plans, --apply --live installs
constitution	deploy.sh --only constitution	no	policy/constitution.md to the box CLAUDE.md, through deploy: --live plans, --apply --live installs
browser	access-browser.sh	yes	which browser backend, and drive it (route/doctor/probe/hosts/cdp)
chrome	access-browser-agent.sh	yes	the operator's Chrome through the Playwright Extension, attended and guarded (router row 4)
refs	doc-graph-generate.sh --refs	no	every edge touching a path or id: references, deploys, generators, stamps (--sites: git grep's shape)
find	standard-catalog.sh --find	no	the scripts, tests, checks, docs and controls of a family, subsystem, domain or system
tree	standard-catalog.sh --tree	no	the seven D-57 levels from the registry, down to the families' components and elements (--files lists paths)
event	event-bus.sh	no	the local event bus: emit, wait (0 match, 3 deadline), since, tail, prune; dispatch, on, pull, subscribe (E2)
ui	status-console.sh	no	a localhost console of the live state as read-only panels: 127.0.0.1, one-use link, stops when idle
scope	scope.sh	no	scope install: create the PORT_ROOT skeleton and an empty private layer (--dry-run, --seed-from-projects); never overwrites
access	access.sh	no	the access register: add, list, has, refs, check, stored, status, rotate, revoke; a ref the register does not name is refused by bin/secret
pack	pack.sh	no	install a workload repo's harbor-pack/ box-wide and remove it exactly: list, install, remove (--dir or --live; dry run unless --apply)
merge-stack	gate-merge-stack.sh	no	merge a plan's PRs in order, each on its own green CI: check, rehearse, merge, verify (docs/design/merge-stack.md)
ship	deploy-fleet.sh	no	merge and deploy opted-in fleet repos unattended, restore a red deploy, queue protected work (docs/design/deploy-fleet.md)
"

# Where the target scripts live. An installed copy at ~/.local/bin/harbor is not
# next to bin/, so the repo is resolved in order: an explicit override, the
# dispatcher's own directory, then the conventional checkout. Reported clearly
# rather than failing with "not found" on a path the caller never saw.
#
# AN EXPLICIT OVERRIDE THAT IS WRONG IS AN ERROR, NOT A FALLBACK. The first cut
# tried HARBOR_SCOPE_BIN, then the dispatcher's directory, then ~/harbor/bin, and took
# the first that had the scripts — so `HARBOR_SCOPE_BIN=/typo harbor status` quietly ran
# the repo copy and reported success. The operator would have believed they had
# tested a different tree. Caught while writing the 127 test, which could not fail
# for exactly this reason.
_self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
# ITS OWN FAILURES ARE LOG LINES (contracts/logging.md, harbor#771), on stderr so a verb's stdout stays
# its own. library-log.sh is looked for beside the dispatcher, then in the checkouts it would dispatch to;
# with none, the two 127 failures below still print what failed and the fix, because recovery must
# not need a file that may be part of what broke.
_lld=''
for _c in "$_self_dir" "${HARBOR_SCOPE_BIN:-${HARBOR_BIN:-}}" "${PORT_ROOT:-$HOME/port}/harbor/bin"; do
  if [ -n "$_c" ] && [ -f "$_c/library-log.sh" ]; then _lld="$_c"; break; fi
done
if [ -n "$_lld" ]; then
  . "$_lld/library-log.sh"
  LOG_FD=2; log_init harbor
fi
_fail127() { # <what failed, and where> <the command that fixes it>
  if [ -n "$_lld" ]; then
    log_fail "$1"
    log_fix "$2"
    log_end || :
  else
    printf 'harbor: %s\n  fix: %s\n' "$1" "$2" >&2
  fi
  exit 127
}
# A native Windows shell is refused before any verb, help included (harbor#833, contracts/platforms.md).
case "$(uname -s 2>/dev/null || :)" in MINGW*|MSYS*|CYGWIN*)
  _w="native Windows shell ($(uname -s)): Harbor runs on macOS and Linux, and on Windows only inside WSL2 (contracts/platforms.md)"
  _wf="install WSL2 (wsl --install), clone Harbor inside the WSL filesystem (~/port/harbor), and run harbor there"
  if [ -n "$_lld" ]; then log_fail "$_w"; log_fix "$_wf"; log_end || :; else printf 'harbor: %s\n  fix: %s\n' "$_w" "$_wf" >&2; fi
  exit 1 ;;
esac
if [ -n "${HARBOR_SCOPE_BIN:-${HARBOR_BIN:-}}" ]; then
  if [ -f "${HARBOR_SCOPE_BIN:-${HARBOR_BIN:-}}/status-generate.sh" ]; then
    BIN="${HARBOR_SCOPE_BIN:-${HARBOR_BIN:-}}"
  else
    _fail127 "HARBOR_SCOPE_BIN=${HARBOR_SCOPE_BIN:-${HARBOR_BIN:-}} has no status-generate.sh — refusing to fall back" "unset HARBOR_SCOPE_BIN HARBOR_BIN"
  fi
else
  for _c in "$_self_dir" "${PORT_ROOT:-$HOME/port}/harbor/bin"; do
    if [ -f "$_c/status-generate.sh" ]; then BIN="$_c"; break; fi
  done
fi

verb_field() { # <verb> <field-number> — empty if the verb is unknown
  printf '%s\n' "$VERBS" | awk -F'\t' -v v="$1" -v f="$2" '$1 == v { print $f; exit }'
}

usage() {
  cat <<EOF
harbor — the Helm (L0) management command.   contract v$CONTRACT_VERSION

  usage: harbor <verb> [args...]

EOF
  printf '%s\n' "$VERBS" | awk -F'\t' 'NF >= 4 {
    printf "  %-12s %-5s %s\n", $1, ($3 == "yes" ? "--json" : ""), $4 }'
  cat <<EOF

  help | --help        this table
  version             the contract version

Verbs marked --json accept it and pass it through. Exit codes: 0 success,
1 the verb reported a problem, 2 usage error, 127 the verb's script is missing.
Frozen in contracts/cli.md; lint rule CLI1 keeps this table equal to it.
EOF
}

VERB="${1:-}"
case "$VERB" in
  ''|help|-h|--help) usage; exit 0 ;;
  version|--version) printf 'harbor contract v%s\n' "$CONTRACT_VERSION"; exit 0 ;;
esac
shift

_run="$(verb_field "$VERB" 2)"
# `harbor status obligations …` (harbor#1050) is the obligations ledger's read side. The verb table is frozen under CLI1, so the
# sub-verb is routed here, before the script is picked, and every other `harbor status` call reaches status-generate.sh unchanged.
if [ "$VERB" = status ] && [ "${1:-}" = obligations ]; then shift; _run="status-obligations.sh show"; fi
# `harbor deploy push <target>` (harbor#1149) shares the core set: a sub-verb row, since the verb table is frozen.
SUBVERBS="
deploy	push	deploy-push.sh
"
_sub="$(printf '%s\n' "$SUBVERBS" | awk -F'\t' -v v="$VERB" -v s="${1:-}" '$1 == v && $2 == s { print $3; exit }')"
if [ -n "$_sub" ]; then shift; _run="$_sub"; fi
SCRIPT="${_run%% *}"
if [ -z "$SCRIPT" ]; then
  # Exit 2, and name the closest thing rather than only complaining: an unknown
  # verb is usually a near-miss, and "unknown verb" with no list is a dead end.
  printf 'harbor: unknown verb "%s"\n' "$VERB" >&2
  _near="$(printf '%s\n' "$VERBS" | awk -F'\t' -v v="$VERB" 'NF>=4 && index($1, substr(v,1,3)) == 1 { print $1 }')"
  [ -n "$_near" ] && printf 'did you mean: %s\n' "$(printf '%s' "$_near" | tr '\n' ' ')" >&2
  printf 'run `harbor help` for the verb list.\n' >&2
  exit 2
fi

# --json ON A VERB THAT DOES NOT SUPPORT IT IS AN ERROR, NOT A NO-OP. Accepting
# and ignoring it is worse than refusing: a caller parsing the output cannot tell
# "no data" from "flag not supported".
if [ "$(verb_field "$VERB" 3)" = "no" ]; then
  for _a in "$@"; do
    if [ "$_a" = "--json" ]; then
      printf 'harbor: %s has no --json. Verbs that do: %s\n' "$VERB" \
        "$(printf '%s\n' "$VERBS" | awk -F'\t' '$3 == "yes" { printf "%s ", $1 }')" >&2
      exit 2
    fi
  done
fi

if [ -z "${BIN:-}" ] || [ ! -f "$BIN/$SCRIPT" ]; then
  # The fix is exact only when the conventional checkout holds the script; otherwise say where to look.
  _fix="none automatic — see contracts/cli.md (which script each verb runs)"
  _hb="${PORT_ROOT:-$HOME/port}/harbor/bin"
  if [ "${BIN:-}" != "$_hb" ] && [ -f "$_hb/$SCRIPT" ]; then
    _fix="HARBOR_SCOPE_BIN='$_hb' harbor $VERB"
  fi
  _fail127 "$SCRIPT is not installed next to the dispatcher (looked in: ${BIN:-$_self_dir, $_hb})" "$_fix"
fi

# The verb's fixed arguments, then the caller's, each word intact. Fixed words carry no glob or space.
if [ "$_run" != "$SCRIPT" ]; then
  set -f
  # shellcheck disable=SC2086
  set -- ${_run#"$SCRIPT" } "$@"
  set +f
fi
# `harbor verify` re-judges after it verifies, so the .helm-judge counter reflects the box the operator just checked and not
# the 05:23 run (no new schedule). Best effort and on stderr: the verdict and exit status stay floor-verify's own.
if [ "$VERB" = verify ] && [ -f "$BIN/audit-triage-run.sh" ] && [ "${HARBOR_AUDIT_TRIAGE_DISABLE:-}" != 1 ]; then
  sh "$BIN/$SCRIPT" "$@"; _rc=$?
  sh "$BIN/audit-triage-run.sh" --live --apply >/dev/null 2>&1 || :
  exit "$_rc"
fi
# exec, so the target's exit status IS harbor's — never remapped, never swallowed.
# A wrapper that turns its child's 1 into a 0 to look calmer is the fail-open
# shape this repo keeps finding in its own history.
exec sh "$BIN/$SCRIPT" "$@"
