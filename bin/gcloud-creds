#!/usr/bin/env sh
# gcloud-creds — snapshot and restore the gcloud credential store.
# SEC-0 · was UNTRACKED in ~/.local/bin until 2026-09-09 and is now here so it
# has history, review and a backup. SEC-0 is a classification chosen to satisfy
# lint S3 -- there is no issue behind this file, and it is credential-store tooling, which is what SEC-0 covers.
#
# WHY IT EXISTS. Measured 2026-09-03: every file under ~/.config/gcloud had an
# mtime newer than 18:26 — the whole tree was destroyed and recreated inside one
# session. Lost with it were the ADC for two workload roles and `tools`,
# the matching `-write` role dirs and `me`, and one `oauth-clients/` desktop client file. That
# last one is the expensive part: Google's shared gcloud client is REFUSED for
# a workload API's scopes ("This app is blocked", measured 2026-07-30), so that workload has
# no route back without that file, and recovery cost a console trip plus five
# interactive browser logins.
#
# NO CAUSE WAS ESTABLISHED. Neither .zsh_history nor any session transcript
# carries a delete of that path, so the actor is unidentified and may not be a
# process this box can hook at all — a Finder drag leaves no trace in either
# record. THAT IS THE WHOLE ARGUMENT FOR THIS TOOL RATHER THAN A GUARD: a rule
# can only refuse the actors it mediates, and the one actor the evidence exonerates
# is the one a Claude Code hook can see. Recoverability does not care who did it.
#
# WHERE THE COPY LIVES. `secret` keeps blob ciphertext under
# ~/.local/share/secret and the passphrase in the login Keychain — a different
# tree from the one that was wiped, so the backup does not share fate with the
# original. It shares a DISK and a home directory, so this is protection against
# the failure that happened, not against losing the volume.
set -eu

ME="${0##*/}"
ROOT="${GCLOUD_CREDS_ROOT:-$HOME/.config/gcloud}"
NAME="${GCLOUD_CREDS_SECRET:-gcloud-store}"
SECRET="${GCLOUD_CREDS_SECRET_BIN:-secret}"

# Status lines are log-lib's, on stderr: stdout is `list`'s file names and nothing else (CONTRACTS/logging.md).
# Installed as a link in ~/.local/bin, so log-lib.sh is looked for beside the file the link resolves to.
_me="$0"
while [ -L "$_me" ]; do _ml="$(readlink "$_me")"; case "$_ml" in /*) _me="$_ml" ;; *) _me="${_me%/*}/$_ml" ;; esac; done
case "$_me" in */*) _here="${_me%/*}" ;; *) _here=. ;; esac
[ -f "$_here/log-lib.sh" ] || { printf '%s: log-lib.sh is missing beside %s\n' "$ME" "$_me" >&2; exit 1; }
. "$_here/log-lib.sh"
log_init gcloud-creds; LOG_FD=2

# die <what failed> [fix command]: FAIL, its fix, the summary, exit 1.
die() {
  log_fail "$1"
  if [ -n "${2:-}" ]; then log_fix "$2"; else log_nofix "the header of bin/gcloud-creds"; fi
  log_end || :
  exit 1
}

usage() {
  cat >&2 <<USAGE
usage: $ME <verb>

  snapshot [--force]   store the credential tree in the Keychain
  restore  [--force]   put it back (refuses to clobber live credentials)
  list                 what a snapshot holds — names only, never contents
  check    [--mint]    are the credentials still there? exit 1 if not

  --mint proves the credential ANSWERS; without it, check proves only that the
  file is present. A present file with a revoked token passes the cheap check.

env: GCLOUD_CREDS_ROOT (default ~/.config/gcloud)
     GCLOUD_CREDS_SECRET (default gcloud-store)
USAGE
  exit 64
}

# Logs are excluded on purpose: they are not credentials, they are the biggest
# thing in the tree, and the July setup deliberately did 'chmod -R go-rwx' then
# 'rm -rf' on them. Caches are excluded because restoring a stale update-check
# is worse than not having one.
tar_excludes() {
  printf '%s\n' --exclude=./logs --exclude='*/logs' \
    --exclude=.last_update_check.json --exclude=.last_survey_prompt.yaml
}

# How many real credentials does the tree hold right now? This is the number the
# safety rule below turns on, so it counts the ADC files that actually carry a
# secret rather than the role dirs, which survive a wipe empty and would make an
# emptied store look populated.
adc_count() {
  [ -d "$ROOT" ] || { printf '0\n'; return 0; }
  find "$ROOT" -type f -name application_default_credentials.json -size +0 2>/dev/null | wc -l | tr -d ' '
}

cmd_snapshot() {
  _force=0; [ "${1:-}" = "--force" ] && _force=1
  [ -d "$ROOT" ] || die "no store at $ROOT" "$ME restore"

  # THE RULE THAT MATTERS MOST IN THIS FILE. A backup that runs AFTER the wipe
  # and overwrites a good snapshot with an empty tree turns a recoverable
  # incident into an unrecoverable one, and it does it while reporting success.
  # So an empty store is refused, loudly, and --force is the only way past.
  _n="$(adc_count)"
  if [ "$_n" = 0 ] && [ "$_force" = 0 ]; then
    die "$ROOT holds no credentials, so a snapshot now would overwrite a good backup with an empty one" "$ME restore"
  fi

  _tmp="$(mktemp -d "${TMPDIR:-/tmp}/harbor.XXXXXX")" || die "mktemp failed"
  trap 'rm -rf "$_tmp"' EXIT INT TERM HUP
  # COPYFILE_DISABLE stops BSD tar writing ._ AppleDouble members, which restore
  # as junk files beside every real one.
  # shellcheck disable=SC2046
  COPYFILE_DISABLE=1 tar czf "$_tmp/store.tgz" $(tar_excludes) -C "$ROOT" . \
    || die "tar failed"
  "$SECRET" putfile "$NAME" "$_tmp/store.tgz" \
    || die "secret putfile failed — nothing was stored"
  log_ok "snapshot stored as secret.$NAME"
  log_note "credentials captured: $_n ADC file(s)"
  log_note "roles: $(ls "$ROOT/identities" 2>/dev/null | tr '\n' ' ')"
  log_end || return 1
}

cmd_restore() {
  _force=0; [ "${1:-}" = "--force" ] && _force=1
  _n="$(adc_count)"
  if [ "$_n" != 0 ] && [ "$_force" = 0 ]; then
    die "$ROOT already holds $_n credential(s), so a restore would overwrite them with the snapshot" "$ME restore --force"
  fi
  mkdir -p "$ROOT" || die "cannot create $ROOT"
  "$SECRET" withfile "$NAME" -- tar xzf '{}' -C "$ROOT" \
    || die "restore failed — $ROOT may be partially written" "$ME check"
  log_ok "restored into $ROOT ($(adc_count) ADC file(s) now present)"
  log_end || return 1
}

cmd_list() {
  "$SECRET" withfile "$NAME" -- tar tzf '{}'
}

cmd_check() {
  _mint=0; [ "${1:-}" = "--mint" ] && _mint=1
  [ -d "$ROOT/identities" ] || die "$ROOT/identities is missing" "$ME restore"
  for _d in "$ROOT"/identities/*/; do
    [ -d "$_d" ] || continue
    _r="$(basename "$_d")"
    if [ ! -s "$_d/application_default_credentials.json" ]; then
      log_fail "$_r: no ADC at $_d""application_default_credentials.json"
      log_fix "$ME restore --force   # or log in again under this role"
      continue
    fi
    if [ "$_mint" = 1 ]; then
      if gcx "$_r" gcloud auth application-default print-access-token >/dev/null 2>&1; then
        log_ok "$_r: mints"
      else
        log_fail "$_r: ADC present but will not mint"
        log_fix "gcx $_r gcloud auth application-default login"
      fi
    else
      log_ok "$_r: adc present"
    fi
  done
  log_end || return 1
}

[ $# -ge 1 ] || usage
VERB="$1"; shift
case "$VERB" in
  snapshot) cmd_snapshot "$@" ;;
  restore)  cmd_restore "$@" ;;
  list)     cmd_list "$@" ;;
  check)    cmd_check "$@" ;;
  -h|--help|help) usage ;;
  *) die "unknown verb '$VERB'" "$ME help" ;;
esac
