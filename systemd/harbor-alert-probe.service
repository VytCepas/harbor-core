# harbor#617 — the Linux/WSL2 twin of launchd/com.harbor.alert.probe.plist, docs/reference/checks.md row `alert.probe`.
# Install and disable: docs/reference/checks.md, "Platforms". WSL2 needs [boot] systemd=true in /etc/wsl.conf.
[Unit]
Description=Harbor check pulse: between-sessions health probe, notifies on state changes

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh %h/.claude/bin/alert-notify.sh
