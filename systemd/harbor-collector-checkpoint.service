# harbor#1181 — the Linux twin of launchd/com.harbor.collector-checkpoint.plist: a SYSTEM unit running as the harborlog user, the second
# uid the observed agent cannot write as. TEMPLATE: bin/collector-setup.sh fills @BIN@, @STORE@ and @SOURCES@ and
# installs it under /etc/systemd/system with sudo; a session cannot. Disable: CHECKS.md, "Platforms".
[Unit]
Description=Harbor collector: sign yesterday's store manifest

[Service]
Type=oneshot
User=harborlog
Group=harborlog
Environment=HARBOR_COLLECTOR_SRC=@SOURCES@
Environment=HARBOR_COLLECTOR_STORE=@STORE@
ExecStart=/bin/sh @BIN@/collector.sh --checkpoint
