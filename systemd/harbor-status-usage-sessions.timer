# harbor#617 — the schedule of launchd/com.harbor.status.usage-sessions.plist; docs/reference/checks.md row `status.usage-sessions`.
[Unit]
Description=Harbor check usage-sessions (schedule)

[Timer]
OnActiveSec=30s
OnCalendar=*-*-* 04:37:00
Persistent=true
Unit=harbor-status-usage-sessions.service

[Install]
WantedBy=timers.target
