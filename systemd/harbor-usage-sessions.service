# harbor#617 — the Linux/WSL2 twin of launchd/com.harbor.usage-sessions.plist, CHECKS.md row `usage-sessions`.
# Install and disable: CHECKS.md, "Platforms". WSL2 needs [boot] systemd=true in /etc/wsl.conf.
[Unit]
Description=Harbor check usage-sessions: per-session token usage

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh %h/.claude/bin/usage-aggregate.sh --sessions --apply --live
IOSchedulingClass=idle
Nice=10
