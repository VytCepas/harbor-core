# harbor#1181 — the Linux twin of launchd/com.harbor.otlp-receiver.plist: a SYSTEM unit running as the harborlog user, the second
# uid the observed agent cannot write as. TEMPLATE: bin/audit-collector-install.sh fills @BIN@, @STORE@ and @SOURCES@ and
# installs it under /etc/systemd/system with sudo; a session cannot. Disable: docs/reference/checks.md, "Platforms".
[Unit]
Description=Harbor OTLP receiver: Claude Code's own telemetry on 127.0.0.1:4318

[Service]
User=harborlog
Group=harborlog
UMask=0077
ExecStart=/usr/bin/python3 -I @BIN@/audit-otlp-receiver.py --store @STORE@
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
