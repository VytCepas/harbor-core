# harbor#1181 — the Linux twin of launchd/com.harbor.collector.plist: a SYSTEM unit running as the harborlog user, the second
# uid the observed agent cannot write as. TEMPLATE: bin/audit-collector-install.sh fills @BIN@, @STORE@ and @SOURCES@ and
# installs it under /etc/systemd/system with sudo; a session cannot. Disable: docs/reference/checks.md, "Platforms".
[Unit]
Description=Harbor collector, every 300 s

[Timer]
OnActiveSec=60
OnUnitActiveSec=300s
Unit=harbor-collector.service

[Install]
WantedBy=timers.target
