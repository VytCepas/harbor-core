# harbor#1181 — the Linux twin of launchd/com.harbor.collector.plist: a SYSTEM unit running as the harborlog user, the second
# uid the observed agent cannot write as. TEMPLATE: bin/collector-setup.sh fills @BIN@, @STORE@ and @SOURCES@ and
# installs it under /etc/systemd/system with sudo; a session cannot. Disable: CHECKS.md, "Platforms".
[Unit]
Description=Harbor collector: copy every observability stream into the second-uid store

[Service]
Type=oneshot
User=harborlog
Group=harborlog
Environment=HARBOR_COLLECTOR_SRC=@SOURCES@
Environment=HARBOR_COLLECTOR_STORE=@STORE@
# read every source whatever its mode (a POSIX ACL would not survive the floor's chmod), and mark its own store
# files append-only (chattr +a)
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_LINUX_IMMUTABLE
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_LINUX_IMMUTABLE
NoNewPrivileges=true
ExecStart=/bin/sh @BIN@/collector.sh
