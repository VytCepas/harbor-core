diff --git a/bin/access-token-probe.sh b/bin/access-token-probe.sh
new file mode 100644
--- /dev/null
+++ b/bin/access-token-probe.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env sh
+# access-token-probe.sh — does the vendor API accept our token? Prints the HTTP status, nothing else.
+set -eu
+ACCOUNT="${1:?usage: access-token-probe.sh <account-id>}"
+case "$ACCOUNT" in *[!0-9]*) echo "access-token-probe: the account id is digits only" >&2; exit 2 ;; esac
+curl -s -o /dev/null -w '%{http_code}\n' -H "Authorization: Bearer $VENDOR_TOKEN" "https://api.example.com/v2/accounts/$ACCOUNT"
diff --git a/docs/how-to/token-probe.md b/docs/how-to/token-probe.md
new file mode 100644
--- /dev/null
+++ b/docs/how-to/token-probe.md
@@ -0,0 +1,4 @@
+# Probe a vendor token
+
+When a vendor call returns 401, run `sh bin/access-token-probe.sh <account-id>`: `200` means the token is good and the
+fault is elsewhere; anything else means the token needs replacing.
