+---
+order: 97
+description: A command that names a vendor console draws a note on how the vendor-side object must be named
+event: PreToolUse
+tool: Bash
+when: always
+once: match
+run: vendor-name-note.sh
+---
+
+<!--
+The rows (ERE TAB note) come from <config dir>/vendor-name.d/*.tsv, written by a workload pack. With no rows the
+pack cannot fire, so it says so once, stamped, instead of staying silent.
+
+Registered: context.vendor-name-note in standards/naming/controls.tsv. Proof: tests/context/vendor-name-note/note.test.sh.
+Disable: delete this file and its script, then `harbor inject --live --apply`.
+-->
diff --git a/context-rules/user/vendor-name-note.sh b/context-rules/user/vendor-name-note.sh
new file mode 100644
--- /dev/null
+++ b/context-rules/user/vendor-name-note.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env sh
+# vendor-name-note: a command that names a vendor console draws the vendor-side naming note.
+# Every line it prints starts [context:vendor-name-note]. No rows at all is said once, never swallowed.
+set -u
+command -v jq >/dev/null 2>&1 || { echo "[context:vendor-name-note] jq is missing: this note cannot fire"; exit 0; }
+CMD="$(jq -r '.tool_input.command // empty' 2>/dev/null)"
+CFG="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
+TAB="$(printf '\t')"
+ROWS=0
+for f in "$CFG"/vendor-name.d/*.tsv; do
+  [ -f "$f" ] || continue
+  while IFS="$TAB" read -r re note; do
+    case "$re" in ''|'#'*) continue ;; esac
+    ROWS=$((ROWS + 1))
+    printf '%s\n' "$CMD" | grep -Eq -- "$re" && { printf '[context:vendor-name-note] Vendor-side name: %s\n' "$note"; exit 0; }
+  done < "$f"
+done
+[ "$ROWS" -gt 0 ] || echo "[context:vendor-name-note] no rows in vendor-name.d: this note cannot fire until a pack writes them"
+exit 0
diff --git a/tests/context/vendor-name-note/note.test.sh b/tests/context/vendor-name-note/note.test.sh
new file mode 100644
--- /dev/null
+++ b/tests/context/vendor-name-note/note.test.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env sh
+# context-rules/user/vendor-name-note.sh: a matching row draws the stamped note; no rows says so, stamped; a miss is silent.
+. "$(dirname "$0")/../../lib/core.sh"; t_init
+TOOL="$T_ROOT/context-rules/user/vendor-name-note.sh"; CFG="$T_TMP/cfg"; mkdir -p "$CFG/vendor-name.d"
+call() { printf '{"tool_input":{"command":"%s"}}' "$1" | CLAUDE_CONFIG_DIR="$CFG" sh "$TOOL"; }
+t_has "no rows: the inert pack says so, with its id" "$(call 'open https://business.facebook.com')" '[context:vendor-name-note] no rows'
+printf 'business\\.facebook\\.com\tname the system user <system>-<service>-<identity>-<purpose>\n' > "$CFG/vendor-name.d/meta.tsv"
+t_has "a matching row: the note, with its id" "$(call 'open https://business.facebook.com')" '[context:vendor-name-note] Vendor-side name'
+t_eq "a command that matches no row: silent" "" "$(call 'ls')"
+t_red context.vendor-name-note
+t_done
