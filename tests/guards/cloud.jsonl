{"id": "gtm-var-url-gcx-write", "rule": "cloud-gtm-version", "want": "deny", "cmd": "B=https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2; TOK=$(gcx gtm-write gcloud auth application-default print-access-token) && curl -sS -X POST -H \"Authorization: Bearer $TOK\" \"${B}/workspaces/${W}:create_version\"", "why": "the skill's own spelling: the host sits in an assignment, the verb on a variable URL"}
{"id": "gtm-var-url-identity-only", "rule": "cloud-gtm-version", "want": "deny", "cmd": "TOK=$(gcx gtm-write gcloud auth application-default print-access-token) && curl -X POST -H \"Authorization: Bearer $TOK\" \"$API/versions/12:publish\"", "why": "no host anywhere; the gtm-write identity is the association"}
{"id": "gtm-python-c", "rule": "cloud-gtm-version", "want": "deny", "cmd": "python3 -c \"import urllib.request as u; u.urlopen(u.Request(\\\"https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version\\\", method=\\\"POST\\\"))\""}
{"id": "gtm-python-heredoc", "rule": "cloud-gtm-version", "want": "deny", "cmd": "cd /x && python3 - <<'EOF'\nB = \"https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2\"\nr = post(f\"{B}/workspaces/{W}:create_version\")\nEOF", "why": "the skill tells you to build these calls in Python"}
{"id": "gtm-wget-uppercase-host-query", "rule": "cloud-gtm-version", "want": "deny", "cmd": "wget --method=POST https://TAGMANAGER.googleapis.com/tagmanager/v2/accounts/1/containers/2/versions/9:publish?alt=json"}
{"id": "gtm-bash-heredoc-runs", "rule": "cloud-gtm-version", "want": "deny", "cmd": "bash <<EOF\ncurl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version\nEOF", "why": "a shell reading the body runs it"}
{"id": "gtm-commit-unquoted-subst-runs", "rule": "cloud-gtm-version", "want": "deny", "cmd": "git commit -F - <<EOF\n$(curl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version)\nEOF", "why": "harbor#798: an unquoted delimiter expands the body, so its $(…) runs"}
{"id": "gtm-abs-path-curl", "rule": "cloud-gtm-version", "want": "deny", "cmd": "/usr/bin/curl -X POST \"https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version\""}
{"id": "gtm-subagent-still-denies", "rule": "cloud-gtm-version", "want": "deny", "cmd": "curl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version", "ctx": {"agent_type": "general-purpose"}}
