{"id": "gtm-workspace-tag-put", "rule": "cloud-gtm-version", "want": "allow", "cmd": "gcx gtm-write curl -X PUT -d @tag.json https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3/tags/7"}
{"id": "gtm-workspace-tag-post", "rule": "cloud-gtm-version", "want": "allow", "cmd": "gcx gtm-write curl -X POST -d @tag.json https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3/tags"}
{"id": "gtm-versions-live-read", "rule": "cloud-gtm-version", "want": "allow", "cmd": "curl -sS \"https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/versions:live\""}
{"id": "gtm-commit-m-prose", "rule": "cloud-gtm-version", "want": "allow", "cmd": "git commit -m \"gtm: never curl https://tagmanager.googleapis.com/x/workspaces/3:create_version or :publish by hand\""}
{"id": "gtm-commit-heredoc-prose", "rule": "cloud-gtm-version", "want": "allow", "cmd": "git commit -F - <<EOF\ndocs: the version route\ncurl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version\nEOF"}
{"id": "gtm-cd-commit-heredoc-prose", "rule": "cloud-gtm-version", "want": "allow", "cmd": "cd /x && git commit -F - <<'EOF'\ndocs: publish route\ncurl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/versions/9:publish\nEOF", "why": "harbor#302 class: the opener is not segment 1, so only the document-body drop keeps this allowed"}
{"id": "gtm-cat-doc-heredoc", "rule": "cloud-gtm-version", "want": "allow", "cmd": "cat > notes.md <<'EOF'\ncurl -X POST https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2/workspaces/3:create_version\nEOF", "why": "a runbook written to a file is a document, not a call"}
{"id": "gtm-mx-version-create", "rule": "cloud-gtm-version", "want": "allow", "cmd": "cd ~/port/standard-repo && bin/mx version --create --name \"STD L1 - publish consent fix\"", "why": "the sanctioned route"}
{"id": "gtm-just-gtm-lint", "rule": "cloud-gtm-version", "want": "allow", "cmd": "just gtm-lint acme --workspace"}
{"id": "gtm-pubsub-publish", "rule": "cloud-gtm-version", "want": "allow", "cmd": "curl -X POST -H \"Authorization: Bearer $T\" https://pubsub.googleapis.com/v1/projects/p/topics/t:publish -d @m.json", "why": "Pub/Sub has :publish too"}
{"id": "gtm-var-publish-unassociated", "rule": "cloud-gtm-version", "want": "allow", "cmd": "curl -X POST \"$T/topics/t:publish\" -d @m.json"}
{"id": "gtm-grep-names-verb", "rule": "cloud-gtm-version", "want": "allow", "cmd": "grep -rn \":create_version\" packages/mx"}
{"id": "gtm-gh-body-prose", "rule": "cloud-gtm-version", "want": "allow", "cmd": "gh pr create --title \"gtm gate\" --body \"denies curl https://tagmanager.googleapis.com/x:publish outside mx\""}
{"id": "gtm-echo-handover", "rule": "cloud-gtm-version", "want": "allow", "cmd": "echo \"publish v12 built from Default Workspace; do NOT re-publish v11\""}
{"id": "gtm-v1-publish", "rule": "cloud-gtm-version", "want": "deny", "cmd": "curl -X POST -H \"Authorization: Bearer $T\" https://tagmanager.googleapis.com/tagmanager/v1/accounts/1/containers/2/versions/9/publish", "why": "PR #947 review: v1 publish has no colon verb"}
{"id": "gtm-v1-create-post", "rule": "cloud-gtm-version", "want": "deny", "cmd": "curl -X POST -H \"Authorization: Bearer $T\" https://tagmanager.googleapis.com/tagmanager/v1/accounts/1/containers/2/versions -d '{\"name\":\"x\"}'", "why": "PR #947 review: v1 create is POST .../versions"}
{"id": "gtm-var-verb-create", "rule": "cloud-gtm-version", "want": "deny", "cmd": "B=https://tagmanager.googleapis.com/tagmanager/v2/accounts/1/containers/2; A=create_version; curl -X POST \"$B/workspaces/3:$A\"", "why": "PR #947 review: the verb assembled by the shell"}
{"id": "gtm-var-verb-braced-publish", "rule": "cloud-gtm-version", "want": "deny", "cmd": "TOK=$(gcx gtm-write gcloud auth application-default print-access-token) && curl -X POST \"$API/versions/12:${V}\"", "why": "PR #947 review: braced variable verb with the gtm-write identity"}
{"id": "gtm-v1-versions-list", "rule": "cloud-gtm-version", "want": "allow", "cmd": "curl -sS -H \"Authorization: Bearer $T\" https://tagmanager.googleapis.com/tagmanager/v1/accounts/1/containers/2/versions", "why": "a v1 GET lists versions: a read"}
{"id": "gtm-var-verb-unassociated", "rule": "cloud-gtm-version", "want": "allow", "cmd": "curl -X POST \"$T/topics/t:$V\" -d @m.json", "why": "a variable verb with no Tag Manager host or identity anywhere"}
