#!/usr/bin/env sh
# tests/run.sh — the runner: every suite in tests/suites.txt in order, or the ones named, then one total line.
#   sh tests/run.sh [suite ...]     a suite is its path relative to tests/
# Exit 0 iff every suite exited 0 and counted no failure; 1 otherwise; 2 on an unknown suite.
# An unlisted tests/**/*.test.sh is red. harbor member project standard
set -u
HERE="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
MANIFEST="$HERE/suites.txt"
LINE_RE='^[A-Za-z0-9._-]+: [0-9]+ passed, [0-9]+ failed$'
[ -f "$MANIFEST" ] || { printf 'run: no suite manifest at %s\n' "$MANIFEST" >&2; exit 2; }
_td="${TMPDIR:-/tmp}"; LOGS="$(mktemp -d "${_td%/}/suites.XXXXXX")" || exit 2
trap 'rm -rf "$LOGS"' EXIT
manifest() { sed 's/#.*//; s/[[:space:]]*$//' "$MANIFEST" | awk 'NF'; }
if [ $# -eq 0 ]; then manifest > "$LOGS/list"; else
  : > "$LOGS/list"
  for a in "$@"; do
    manifest | grep -qx "$a" || { printf 'run: %s is not a suite in tests/suites.txt\n' "$a" >&2; exit 2; }
    printf '%s\n' "$a" >> "$LOGS/list"
  done
fi
P=0; F=0; BAD=0
if [ $# -eq 0 ]; then
  ( cd "$HERE" && find . -name '*.test.sh' | sed 's|^\./||' | sort ) > "$LOGS/disk"
  manifest | sort > "$LOGS/listed"
  for u in $(comm -23 "$LOGS/disk" "$LOGS/listed"); do
    printf '  FAIL: %s is a suite on disk that tests/suites.txt does not name\n' "$u" >&2; BAD=1; F=$((F + 1))
  done
fi
while IFS= read -r s; do
  printf '── %s\n' "$s"
  ( cd "$HERE" && sh "$s" ) </dev/null > "$LOGS/out" 2>&1; rc=$?
  line="$(grep -aE "$LINE_RE" "$LOGS/out" | tail -n 1)"
  if [ -n "$line" ]; then
    printf '%s\n' "$line"
    p="$(printf '%s' "$line" | sed 's/.*: \([0-9]*\) passed, .*/\1/')"
    f="$(printf '%s' "$line" | sed 's/.* passed, \([0-9]*\) failed$/\1/')"
  else p=0; f=1; printf '  FAIL: %s printed no summary line\n' "$s" >&2; fi
  [ "$rc" -eq 0 ] || [ "$f" -gt 0 ] || f=1
  P=$((P + p)); F=$((F + f))
  if [ "$rc" -ne 0 ] || [ "$f" -gt 0 ]; then
    BAD=1; grep -aE '^  FAIL: ' "$LOGS/out" | head -n 20 >&2
    printf '  FAIL: %s exited %s\n' "$s" "$rc" >&2
  fi
done < "$LOGS/list"
printf '%s: %d passed, %d failed\n' "$(basename "$(dirname "$HERE")")" "$P" "$F"
[ "$BAD" -eq 0 ] && [ "$F" -eq 0 ]
