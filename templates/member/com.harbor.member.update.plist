<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE, NOT INSTALLED (harbor#1278, step 12). Nothing installs this file, and nothing may until the operator says yes to this
     schedule in so many words: a job that rewrites root-owned floor code is its own decision, apart from the rest of the install.

     To install after that yes, as root, by hand (macOS):
       cp com.harbor.member.update.plist /Library/LaunchDaemons/com.harbor.member.update.plist
       chown root:wheel /Library/LaunchDaemons/com.harbor.member.update.plist && chmod 644 /Library/LaunchDaemons/com.harbor.member.update.plist
       launchctl bootstrap system /Library/LaunchDaemons/com.harbor.member.update.plist
     To see it work once:  launchctl kickstart -k system/com.harbor.member.update ; cat /var/log/com.harbor.member.update.err
     To turn it off:       launchctl bootout system/com.harbor.member.update ; rm /Library/LaunchDaemons/com.harbor.member.update.plist

     It is not in launchd/, so bin/deploy.sh does not render or load it. One run per start, then it exits (bin/member-update.sh). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.harbor.member.update</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Library/Application Support/ClaudeCode/harbor/bin/member-update.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StandardOutPath</key><string>/var/log/com.harbor.member.update.out</string>
  <key>StandardErrorPath</key><string>/var/log/com.harbor.member.update.err</string>
</dict>
</plist>
