#!/bin/sh
# G1 (harbor#25) — fail-CLOSED gitleaks pre-push gate for the Log repo.
# Blocks the push when gitleaks finds a secret in the commits this push sends
# OR when gitleaks is missing. Install: cp into ~/.claude/MEMORY/.git/hooks/.
command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks missing — push BLOCKED (fail-closed)" >&2
  exit 1
}
TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "pre-push: not inside a git work tree — push BLOCKED (fail-closed)" >&2
  exit 1
}
# THE PUSHED RANGE, NOT THE WHOLE HISTORY (124ey1kjcu0 P3): the full scan was 13.8 CPU-s over 23,737
# commits on every push, at 200-470 pushes a day. git hands the hook one `<local ref> <local sha>
# <remote ref> <remote sha>` line per ref: an update scans <remote sha>..<local sha>, a new ref scans
# <local sha> --not --remotes=<remote>, a deletion scans nothing. Whatever the range cannot be read for
# (no lines on stdin, a sha that is not hex, a remote sha this repo lacks, an odd remote name) scans
# the whole history, as before. A secret already on the remote is the nightly full scan's:
# bin/memory-secret-scan.sh, launchd com.harbor.memory.secret-scan.
#
# THE SUBCOMMAND IS A DIALECT. gitleaks 8.19 introduced `gitleaks git`; 8.18.4 —
# the version .github/workflows/governance.yml pins by exact URL — has no such
# verb and exits 1 on it. With `--exit-code 1` meaning "a leak was found", an
# absent subcommand is INDISTINGUISHABLE from a finding, so on 8.18.4 this hook
# blocked every push in the Log repo and said it had found a secret.
#
# THE ONLY COPY OF guard-lib's floor_gitleaks_tree THAT IS ALLOWED TO EXIST, and
# the reason is in this file's own second line: it is copied into
# ~/.claude/MEMORY/.git/hooks/, a DIFFERENT repository, where harbor's bin/ may
# not be present at all. A hook that sources a library from a path outside the
# repo it guards fails open the moment that path moves — so this one stays
# standalone, and the duplication is the price of that. library-admission.sh carries the
# reference implementation and the measured equivalence; keep the two in step.
scan() { # [git log options]; none = the whole history
  if gitleaks git --help >/dev/null 2>&1; then
    if [ -n "$1" ]; then gitleaks git --no-banner --exit-code 1 --log-opts="$1" "$TOP"
    else gitleaks git --no-banner --exit-code 1 "$TOP"; fi
  else
    if [ -n "$1" ]; then gitleaks detect --no-banner --exit-code 1 --log-opts="$1" --source "$TOP"
    else gitleaks detect --no-banner --exit-code 1 --source "$TOP"; fi
  fi
}
REMOTE="${1:-origin}"
case "$REMOTE" in ''|-*|*[!A-Za-z0-9._-]*) REMOTE='' ;; esac
FULL=0; N=0; RANGES=''
if [ -t 0 ]; then FULL=1; else
  while read -r _lr _ls _rr _rs; do
    [ -n "$_lr" ] || continue
    N=$((N + 1))
    case "$_ls$_rs" in *[!0123456789abcdef]*) FULL=1; continue ;; esac
    case "$_ls" in *[!0]*) ;; *) continue ;; esac   # a deletion sends no commit
    case "$_rs" in
      *[!0]*) if git cat-file -e "$_rs^{commit}" 2>/dev/null; then RANGES="$RANGES
$_rs..$_ls"; else FULL=1; fi ;;
      *) if [ -n "$REMOTE" ]; then RANGES="$RANGES
$_ls --not --remotes=$REMOTE"; else FULL=1; fi ;;
    esac
  done
fi
[ "$N" -gt 0 ] || FULL=1
if [ "$FULL" -eq 1 ]; then scan ''; exit $?; fi
_old_ifs="$IFS"; IFS='
'
for _r in $RANGES; do
  IFS="$_old_ifs"
  scan "$_r" || exit 1
done
exit 0
