<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- harbor:template-only
     THIS FILE IS A TEMPLATE (harbor#630). Do not cp it: @HOME@ and the other placeholders in it would be
     installed as literal text, and launchd loads such a job and then fails every time it runs. Render it:

       sh ~/port/harbor/bin/deploy-launchd-render.sh ~/port/harbor/launchd/com.harbor.status.fleet-snapshot.plist > ~/Library/LaunchAgents/com.harbor.status.fleet-snapshot.plist

     A cp line in the comment below predates the template. It is kept so the rendered file stays byte-identical
     to the one already installed: follow this block, not that line. This block is not installed;
     bin/deploy-launchd-render.sh drops it. -->
<!-- L0-5-interim (harbor#21): interval refresher for the statusline fleet glyph.
     TEMPLATE — launchd does not expand $HOME: replace @HOME@ with your
     home dir on install. Install (Phase-0 home rule: repo is source, ~/.claude is
     the deploy target):
       cp bin/status-fleet-snapshot-refresh.sh bin/status-fleet-glyph.sh ~/.claude/bin/
       cp launchd/com.harbor.status.fleet-snapshot.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.harbor.status.fleet-snapshot.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.harbor.status.fleet-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@HOME@/.claude/bin/status-fleet-snapshot-refresh.sh</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin:@HARBOR_SCOPE_LOCAL_BIN@</string>
  </dict>
  <key>StandardErrorPath</key><string>/tmp/com.harbor.status.fleet-snapshot.err</string>
</dict>
</plist>
