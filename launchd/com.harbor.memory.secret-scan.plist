<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- harbor:template-only
     THIS FILE IS A TEMPLATE (harbor#630). Do not cp it: render it.

       sh ~/port/harbor/bin/deploy-launchd-render.sh ~/port/harbor/launchd/com.harbor.memory.secret-scan.plist > ~/Library/LaunchAgents/com.harbor.memory.secret-scan.plist

     This block is not installed; bin/deploy-launchd-render.sh drops it. -->
<!-- docs/reference/checks.md `memory.secret-scan` (124ey1kjcu0 P3): the work-log repository's whole history through gitleaks, nightly
     at 03:40 local, as the operator (a LaunchAgent in the gui domain). While it is loaded, worklog/pre-push scans only the commits an update
     sends, so a secret already on the remote is found here; until then the pre-push scans the whole history. It runs the INSTALLED bin/memory-secret-scan.sh, which deploy-runtime-install.sh ships.

     NOT INSTALLED BY DEPLOY: it carries no deploy-installs marker, because a recurring job needs the operator's own yes. Load it:
       sh ~/port/harbor/bin/deploy-launchd-render.sh ~/port/harbor/launchd/com.harbor.memory.secret-scan.plist > ~/Library/LaunchAgents/com.harbor.memory.secret-scan.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.harbor.memory.secret-scan.plist

     See it work: `launchctl kickstart -k gui/$(id -u)/com.harbor.memory.secret-scan`, then `cat ~/.claude/cache/checks/memory.secret-scan.json`.

     Disable (docs/reference/checks.md's two-lookup rule):
       launchctl bootout gui/$(id -u)/com.harbor.memory.secret-scan
       rm ~/Library/LaunchAgents/com.harbor.memory.secret-scan.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.harbor.memory.secret-scan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@HOME@/.claude/bin/memory-secret-scan.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>40</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/com.harbor.memory.secret-scan.out</string>
  <key>StandardErrorPath</key><string>/tmp/com.harbor.memory.secret-scan.err</string>
</dict>
</plist>
