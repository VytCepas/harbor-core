<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- docs/reference/checks.md `event.dispatch` (harbor#1044, E2): `event-dispatch.sh dispatch`, the one follower of the event
     bus. It wakes on a new bus line (`event-bus.sh wait`, tail -F), never on a timer, and at least hourly for
     rule backstops. Its position is the byte offset in ~/.local/state/harbor/events/dispatch/offsets.

     INSTALLED BY DEPLOY (harbor:deploy-installs is the marker bin/deploy-launchd-sync.sh reads: `sh bin/deploy.sh --apply --live`
     renders this file into ~/Library/LaunchAgents and loads it, harbor#1437, the operator's decision of 2026-11-02 that nothing
     needs turning on by hand). A deploy that changes event-dispatch.sh restarts it. It reacts only through the event rules
     deploy reconciles from contracts/event-rules.tsv, and spawns nothing until ~/.claude/.helm-dispatch/spawn.on exists,
     which a deploy never creates.

     KeepAlive SuccessfulExit=false: restarted after a crash, left down after exit 0, which is how
     `touch .../dispatch/dispatch.off` stops it. A missing dependency (jq, perl, or a bus that does not pass the
     cause on) also exits 0, after a NOT FOLLOWING line in cache/checks.log and a down receipt pulse reports: a non-zero exit would be restarted
     every ThrottleInterval (10 s) and a missing tool never comes back by itself. Aqua: a spawned `claude -p` authenticates as the operator
     through OAuth, whose credentials are in the login keychain.

     TEMPLATE: launchd does not expand $HOME, so the home and local-bin paths below are placeholders that
     bin/deploy-launchd-render.sh fills in from contracts/roots.tsv when the plist is installed; never cp this file (harbor#630).
     A Claude session cannot install this, by design (#555 decision 3): only the operator's deploy does.

     Disable (docs/reference/checks.md's two-lookup rule):
       launchctl bootout gui/$(id -u)/com.harbor.event.dispatch
       rm ~/Library/LaunchAgents/com.harbor.event.dispatch.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.harbor.event.dispatch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>@HOME@/.claude/bin/event-dispatch.sh</string>
    <string>dispatch</string>
  </array>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>RunAtLoad</key><true/>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- /opt/homebrew/bin for jq; ~/.local/bin for claude, which only a --spawn rule runs. -->
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/opt/homebrew/bin:/usr/local/bin:@HARBOR_SCOPE_LOCAL_BIN@</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>StandardOutPath</key><string>/tmp/com.harbor.event.dispatch.out</string>
  <key>StandardErrorPath</key><string>/tmp/com.harbor.event.dispatch.err</string>
</dict>
</plist>
