{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harbor/contracts/schemas/marker-cases.schema.json",
  "title": "marker fixtures (v1)",
  "description": "The shared cases every reader of the detect-and-defer marker runs (contracts/marker.md). Harbor owns the file; yard and fleet read it in place, so a field renamed here breaks a reader in another repo. Open to new keys within a version, as the other seams are (additive only).",
  "x-schema-version": 1,
  "x-fixture": "fixtures/marker/cases.json",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "why", "expect", "settled"],
      "properties": {
        "id": { "type": "string", "pattern": "^M[0-9][0-9]-" },
        "why": { "type": "string" },
        "tree": { "type": "array", "items": { "type": "string" } },
        "files": { "type": "object" },
        "symlinks": { "type": "array", "items": { "type": "object", "required": ["from", "to"] } },
        "cwd": { "type": ["string", "null"], "description": "null where the hook payload carries no cwd: that case is about the missing field" },
        "absolute_cwd": { "type": "string" },
        "home": { "type": "string" },
        "port_root": { "type": "string" },
        "port_root_unset": { "type": "boolean" },
        "expect": { "enum": ["repo", "ambient"] },
        "expect_root": { "type": "string" },
        "expect_log_writer": { "type": "string" },
        "settled": { "type": "boolean" },
        "roles": { "type": "array", "items": { "enum": ["resolver", "allowlist", "descriptor"] } },
        "roles_why": { "type": "string" },
        "resolution": { "type": "string" },
        "observed_project_init": { "type": "string" }
      }
    }
  }
}
